# Copy to `.env` (gitignored) and fill in, or export these in your shell.
# Nothing here is needed to play the game, run the tests or build the site —
# only to play against Jev.

# TypeSafe API key, from https://console.typesafe.ai/keys.
#
# Read in two places, and never by the browser:
#   - `farkle --opponent jev` reads it from the process environment;
#   - `npm run dev:web` reads it in the Vite config (apps/web/vite.config.ts)
#     and attaches it to proxied requests, so the bundle never contains it.
#
# The CLI does not read this file on its own. Either export the variable, or:
#   set -a; source .env; set +a
TYPESAFE_API_KEY=

# Optional. Append every Jev request and response to this file as JSONL, for
# debugging what the model was actually told and what it answered.
# JEV_TRANSCRIPT=jev.jsonl
