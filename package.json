{
  "name": "farkle",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run build -w @farkle/engine && npm run build -w @farkle/cli",
    "play": "npm run build --silent && node apps/cli/dist/main.js"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "vitest": "^0.34.6"
  }
}
